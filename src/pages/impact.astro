---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Our Impact">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-[#1C2354] mb-8">Our Impact</h1>
    
    <div class="bg-white p-8 rounded-lg shadow-md border-t-4 border-[#00B5E2]">
      <h2 class="text-2xl font-bold mb-2">EU-Funded Youth Advocacy Project (2026)</h2>
      <p class="text-gray-600 mb-4"><strong>Location:</strong> Benin City, Edo State.</p>
      <p class="text-gray-600 mb-4"><strong>Partners:</strong> European Union, Policy and Legal Advocacy Centre (PLAC).</p>
      <p class="text-gray-700"><strong>Outcome:</strong> Trained 30 youth leaders on legislative processes and produced a policy recommendation for an Edo State Youth Advisory Council.</p>
    </div>
  </div>
</Layout>
