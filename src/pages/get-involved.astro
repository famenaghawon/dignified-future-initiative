---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Get Involved">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-[#1C2354] mb-6">Get Involved</h1>
    <p class="text-lg mb-8">Whether you are a young person looking to participate, a professional willing to mentor, or an organization seeking partnership, there are many ways to join us.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-lg shadow-md text-center">
        <h2 class="text-xl font-bold mb-3">Volunteer</h2>
        <p class="text-gray-600 mb-4">Join our team of volunteers and contribute your skills to our programmes.</p>
        <a href="/contact" class="inline-block bg-[#00B5E2] text-white px-6 py-2 rounded font-semibold hover:bg-[#0090B5]">Apply Now</a>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md text-center">
        <h2 class="text-xl font-bold mb-3">Partner With Us</h2>
        <p class="text-gray-600 mb-4">We are open to partnerships with organizations that share our vision.</p>
        <a href="/contact" class="inline-block bg-[#1C2354] text-white px-6 py-2 rounded font-semibold hover:bg-[#2a347a]">Contact Us</a>
      </div>
    </div>
  </div>
</Layout>
