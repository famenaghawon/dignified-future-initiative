---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <section class="bg-[#1C2354] text-white py-20 -mt-12 -mx-4 px-4">
    <div class="container mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Empowering Young People. Building a Dignified Future.</h1>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        DFI is a youth-led organization committed to empowering young people through leadership development, policy advocacy, and community-based initiatives.
      </p>
      <a href="/about" class="bg-[#00B5E2] text-white px-8 py-3 rounded-lg font-semibold hover:bg-[#0090B5] transition">
        Learn More
      </a>
    </div>
  </section>
</Layout>
