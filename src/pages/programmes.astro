---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Our Programmes">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold text-[#1C2354] mb-8">Our Programmes</h1>
    
    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-[#00B5E2] mb-10">
      <span class="bg-[#00B5E2] text-white text-xs font-bold px-2 py-1 rounded uppercase tracking-wide">Active Project</span>
      <h2 class="text-2xl font-bold mt-3 mb-2">Youth for Policy Advocacy & Development</h2>
      <p class="text-gray-700 mb-4">An EU-funded and PLAC-supported initiative that brought together youth leaders in Edo State to strengthen policy advocacy and democratic engagement.</p>
      <a href="/impact" class="text-[#00B5E2] font-semibold hover:underline">View Project Details &rarr;</a>
    </div>

    <h2 class="text-2xl font-bold text-[#1C2354] mb-4">Programmes in Development</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h3 class="font-bold text-lg mb-2">Education & Learning</h3>
        <p class="text-gray-600 text-sm">Scholarships, school supplies, and educational support for underserved communities.</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h3 class="font-bold text-lg mb-2">Digital & Vocational Skills</h3>
        <p class="text-gray-600 text-sm">Training in digital literacy, vocational skills, and entrepreneurship.</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h3 class="font-bold text-lg mb-2">Research & Innovation</h3>
        <p class="text-gray-600 text-sm">Policy research, dialogue, and practical solutions to community challenges.</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <h3 class="font-bold text-lg mb-2">Mentorship & Inclusion</h3>
        <p class="text-gray-600 text-sm">Mentorship programs and support for young women and vulnerable groups.</p>
      </div>
    </div>
  </div>
</Layout>
